    { "key": "strength", "label": "Strength", "type": "range", "min": 10, "max": 100, "default": 70, "cssVar": "--pane-strength" },
    { "key": "softness", "label": "Softness", "type": "range", "min": 0, "max": 60, "default": 30, "cssVar": "--pane-softness" }
  ]
