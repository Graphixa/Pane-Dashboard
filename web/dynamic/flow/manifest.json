{
  "id": "flow",
  "name": "Flow",
  "description": "Fluid colour ribbons.",
  "controls": [
    { "key": "seed", "label": "Colour", "type": "colour", "default": "#f3004d", "cssVar": "--pane-seed" },
    { "key": "seed2", "label": "Second colour", "type": "colour", "default": "#7c3aed", "cssVar": "--pane-seed-2" },
    { "key": "speed", "label": "Speed", "type": "range", "min": 0, "max": 100, "default": 55, "cssVar": "--pane-speed", "map": "duration" },
    { "key": "blur", "label": "Softness", "type": "range", "min": 0, "max": 60, "default": 25, "cssVar": "--pane-blur" },
    { "key": "opacity", "label": "Opacity", "type": "range", "min": 10, "max": 100, "default": 50, "cssVar": "--pane-opacity" }
  ]
}
