{
  "id": "bokeh",
  "name": "Bokeh",
  "description": "Out-of-focus light discs.",
  "controls": [
    { "key": "seed", "label": "Colour", "type": "colour", "default": "#7eb6ff", "cssVar": "--pane-seed" },
