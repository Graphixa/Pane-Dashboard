{
  "id": "waves",
  "name": "Waves",
  "description": "Soft rolling bands over a gradient.",
  "controls": [
    { "key": "seed", "label": "Colour", "type": "colour", "default": "#c0d9ed", "cssVar": "--pane-seed" },
    { "key": "speed", "label": "Speed", "type": "range", "min": 0, "max": 100, "default": 40, "cssVar": "--pane-speed", "map": "duration" },
    { "key": "strength", "label": "Strength", "type": "range", "min": 10, "max": 100, "default": 55, "cssVar": "--pane-strength" },
    {
      "key": "palette",
      "label": "Palette",
      "type": "select",
      "default": "dusk",
      "cssVar": "--pane-palette",
      "options": [
        { "value": "dusk", "label": "Dusk" },
        { "value": "ocean", "label": "Ocean" },
        { "value": "forest", "label": "Forest" },
        { "value": "mist", "label": "Mist" }
      ]
    }
  ]
}
